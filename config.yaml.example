# local-legal configuration reference
#
# This file documents every setting the application reads.
# Copy relevant values to a .env file at the repo root — the app
# reads from environment variables, not from this file directly.
#
# Quick start:
#   cp .env.example .env
#   # edit .env with your chosen provider settings
#   docker compose up

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# Which provider to use. One of: ollama, openrouter, anthropic
# Default: ollama
PROVIDER: ollama

# Model name. Format depends on provider:
#   ollama      — bare model name:  llama3.1 | mistral | gemma2
#   openrouter  — vendor/model:     openai/gpt-4o-mini | anthropic/claude-haiku-4
#   anthropic   — model ID:         claude-3-5-haiku-20241022 | claude-sonnet-4-6
MODEL: llama3.1

# ---------------------------------------------------------------------------
# Provider API keys (only required for the chosen provider)
# ---------------------------------------------------------------------------

# OpenRouter — get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY: sk-or-...

# Anthropic — get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY: sk-ant-...

# ---------------------------------------------------------------------------
# Ollama endpoint
# ---------------------------------------------------------------------------

# Only set this if you need a different endpoint. Default (Docker) is
# http://ollama:11434 which resolves to the Ollama container.
# OLLAMA_BASE_URL: http://ollama:11434

# ---------------------------------------------------------------------------
# Docker compose notes
# ---------------------------------------------------------------------------
#
#   docker compose up
#
# This starts all three services: backend (port 8000), frontend (port 3000),
# and Ollama (port 11434). On first run the llama3.1 model is downloaded
# automatically — about 5 GB, so it takes a minute.
#
# To change the model, edit the ollama service's `command` in
# docker-compose.yml and replace `llama3.1` with your chosen model.
#
# Cloud providers need no local GPU — set PROVIDER and the relevant API key
# in .env and docker compose up as normal. The Ollama container will still
# start but won't be used.
